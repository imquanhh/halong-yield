{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "agent/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/cron/cycle", "schedule": "47 6 * * *" },
    { "path": "/cron/tick", "schedule": "47 18 * * *" }
  ],
  "git": { "deploymentEnabled": { "data": false } }
}
